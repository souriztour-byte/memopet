# ─── Shopify Storefront API ──────────────────────────────────────────────
# Leave these empty to run the store in demo mode (local catalog, no checkout).
# Create a token in Shopify admin → Settings → Apps and sales channels →
# Develop apps (or the Headless sales channel) → Storefront API access token.
SHOPIFY_STORE_DOMAIN=            # e.g. your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN= # public Storefront API token
# Optional: use a private (server-only) Storefront token instead of the public one.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Optional: Storefront API version (defaults to 2026-07).
SHOPIFY_STOREFRONT_API_VERSION=
# Optional: signing secret shown under Settings → Notifications → Webhooks,
# used by /api/revalidate to verify product/collection webhooks.
SHOPIFY_WEBHOOK_SECRET=

# Handle of the paw washer product in Shopify (used by the hero and announcement bar).
NEXT_PUBLIC_FEATURED_PRODUCT_HANDLE=silicone-paw-washer

# ─── Store details (shown on Contact, FAQ and policy pages) ─────────────
NEXT_PUBLIC_SITE_URL=            # e.g. https://mimipets.com
NEXT_PUBLIC_SUPPORT_EMAIL=       # e.g. hello@mimipets.com
NEXT_PUBLIC_INSTAGRAM_HANDLE=    # without the @, e.g. mimipets
# Legal entity shown in the Terms of Service and Privacy Policy.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_LEGAL_BUSINESS_ADDRESS=
